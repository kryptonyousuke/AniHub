{
  "name": "anihub",
  "version": "0.3.0-alpha",
  "description": "AniHub is your anime hub :D",
  "author": {
    "name": "Krypton Yousuke",
    "email": "kryptonyousuke@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "dev": "vite --host",
    "electron": "electron .",
    "start": "pnpm run dev",
    "build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.kryptonsolutions.anihub",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "productName": "AniHub",
    "directories": {
      "buildResources": "assets",
      "output": "dist_electron"
    },
    "files": [
      "./dist/**/**",
      "./src/internal/*",
      "./main.js",
      "./preload.js",
      "./package.json"
    ],
    "win": {
      "icon": "./build-icon/icons/win/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "icon": "./build-icon/icons/png/512x512.png",
      "category": "Video;AudioVideo;Network;",
      "desktop": {
        "entry": {
          "executableName": "AniHub",
          "GenericName": "AniHub is your anime hub :D",
          "Terminal": false,
          "MimeType": "x-scheme-handler/anihub;",
          "StartupWMClass": "anihub"
        }
      },
      "target": [
        "AppImage",
        "pacman",
        "flatpak",
        "deb",
        "rpm",
        "tar.xz",
        "tar.gz"
      ],
      "maintainer": "Krypton Yousuke <kryptonyousuke@gmail.com>"
    }
  },
  "keywords": [
    "streaming",
    "video",
    "anime",
    "manga"
  ],
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "ansi-regex": "^6.4.0",
    "concurrently": "^10.0.6",
    "electron": "43.2.0",
    "electron-builder": "^26.18.0",
    "electron-icon-builder": "^2.0.1",
    "gauge": "^5.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify/react": "^6.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "phantomjs-prebuilt"
    ]
  }
}